+
+constexpr UINT kSwapChainBufferCount = 2;
+constexpr DWORD kStatusGraphicsPresentOccluded = 0xC01E0006u;
+constexpr uint64_t kCapabilities =
+    kKirakaraFlutterCompositorDirectComposition |
+    kKirakaraFlutterCompositorPremultipliedAlpha |
+    kKirakaraFlutterCompositorSyntheticStageProducer |
+    kKirakaraFlutterCompositorIndependentStageProducer |
+    kKirakaraFlutterCompositorCompositorClockPacing |
+    kKirakaraFlutterCompositorInPlaceResize;
+
+DXGI_SWAP_CHAIN_DESC1 MakeCompositionSwapChainDescription(size_t width,
+                                                          size_t height,
+                                                          UINT flags) {
+  DXGI_SWAP_CHAIN_DESC1 description{};
+  description.Width = static_cast<UINT>(width);
+  description.Height = static_cast<UINT>(height);
+  description.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+  description.Stereo = FALSE;
+  description.SampleDesc.Count = 1;
+  description.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+  description.BufferCount = kSwapChainBufferCount;
+  description.Scaling = DXGI_SCALING_STRETCH;
+  description.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+  description.AlphaMode = DXGI_ALPHA_MODE_PREMULTIPLIED;
+  description.Flags = flags;
+  return description;
+}
+
+}  // namespace
+
+std::unique_ptr<CompositionWindowSurface> CompositionWindowSurface::Create(
+    Manager* manager,
+    const KirakaraFlutterCompositorConfig& config,
+    const std::shared_ptr<KirakaraCompositorState>& state,
+    size_t width,
+    size_t height) {
+  auto surface = std::unique_ptr<CompositionWindowSurface>(
+      new CompositionWindowSurface(manager, config, state, width, height));
+  if (!surface->Initialize()) {
+    return nullptr;
+  }
+  return surface;
+}
+
+CompositionWindowSurface::CompositionWindowSurface(
+    Manager* manager,
+    const KirakaraFlutterCompositorConfig& config,
+    std::shared_ptr<KirakaraCompositorState> state,
+    size_t width,
+    size_t height)
+    : WindowSurface(manager ? manager->egl_display() : EGL_NO_DISPLAY,
+                    manager && manager->render_context()
+                        ? manager->render_context()->GetHandle()
+                        : EGL_NO_CONTEXT,
+                    EGL_NO_SURFACE,
+                    width,
+                    height),
+      manager_(manager),
+      config_(config),
+      state_(std::move(state)),
+      width_(width),
+      height_(height) {}
+
+CompositionWindowSurface::~CompositionWindowSurface() {
+  Destroy();
+}
+
+bool CompositionWindowSurface::Initialize() {
+  if (!manager_ || !manager_->IsValid() || !state_ || width_ == 0 ||
+      height_ == 0 || width_ > std::numeric_limits<UINT>::max() ||
+      height_ > std::numeric_limits<UINT>::max()) {
+    return Fail(E_INVALIDARG, "validate composition surface arguments");
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11Device> angle_device;
+  if (!manager_->GetDevice(&angle_device) || !angle_device) {
+    return Fail(E_NOINTERFACE, "resolve ANGLE D3D11 device");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIDevice> angle_dxgi_device;
+  HRESULT result = angle_device.As(&angle_dxgi_device);
+  if (FAILED(result)) {
+    return Fail(result, "query ANGLE IDXGIDevice");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+  result = angle_dxgi_device->GetAdapter(&adapter);
+  if (FAILED(result)) {
+    return Fail(result, "resolve ANGLE DXGI adapter");
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIFactory2> factory;
+  result = adapter->GetParent(IID_PPV_ARGS(&factory));
+  if (FAILED(result)) {
+    return Fail(result, "resolve IDXGIFactory2");
+  }
+
+  if (!CreateFlutterSwapChain(angle_device.Get(), factory.Get()) ||
+      !CreateSyntheticStage(adapter.Get(), factory.Get()) ||
+      !CreateCompositionTree(angle_dxgi_device.Get()) ||
+      !CreateFlutterEglSurface(angle_device.Get())) {
+    return false;
+  }
+
+  stage_stop_event_ = ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+  if (!stage_stop_event_) {
+    return Fail(HRESULT_FROM_WIN32(::GetLastError()),
+                "create Stage stop event");
+  }
+
+  state_->width.store(static_cast<uint32_t>(width_), std::memory_order_relaxed);
+  state_->height.store(static_cast<uint32_t>(height_),
+                       std::memory_order_relaxed);
+  state_->capabilities.store(kCapabilities, std::memory_order_release);
+  state_->initialization_hresult.store(S_OK, std::memory_order_release);
+  state_->last_resize_hresult.store(S_OK, std::memory_order_release);
+  state_->active.store(true, std::memory_order_release);
+  valid_ = true;
+  StartStageProducer();
+  return true;
+}
+
+bool CompositionWindowSurface::CreateFlutterSwapChain(
+    ID3D11Device* angle_device,
+    IDXGIFactory2* factory) {
+  const DXGI_SWAP_CHAIN_DESC1 description =
+      MakeCompositionSwapChainDescription(width_, height_, 0);
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain;
+  HRESULT result = factory->CreateSwapChainForComposition(
+      angle_device, &description, nullptr, &swap_chain);
+  if (FAILED(result)) {
+    return Fail(result, "create Flutter composition swapchain");
+  }
+  result = swap_chain.As(&flutter_swap_chain_);
+  if (FAILED(result)) {
+    return Fail(result, "query Flutter IDXGISwapChain3");
+  }
+  return true;
+}
+
+bool CompositionWindowSurface::CreateSyntheticStage(IDXGIAdapter* adapter,
+                                                    IDXGIFactory2* factory) {
+  D3D_FEATURE_LEVEL feature_level{};
+  HRESULT result = ::D3D11CreateDevice(
+      adapter, D3D_DRIVER_TYPE_UNKNOWN, nullptr,
+      D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0, D3D11_SDK_VERSION,
+      &stage_device_, &feature_level, &stage_context_);
+  if (FAILED(result)) {
+    return Fail(result, "create independent Stage D3D11 device");
+  }
+
+  const DXGI_SWAP_CHAIN_DESC1 description =
+      MakeCompositionSwapChainDescription(width_, height_, 0);
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swap_chain;
+  result = factory->CreateSwapChainForComposition(
+      stage_device_.Get(), &description, nullptr, &swap_chain);
+  if (FAILED(result)) {
+    return Fail(result, "create Stage composition swapchain");
+  }
+  result = swap_chain.As(&stage_swap_chain_);
+  if (FAILED(result)) {
+    return Fail(result, "query Stage IDXGISwapChain3");
+  }
+
+  return true;
+}
+
+bool CompositionWindowSurface::CreateCompositionTree(
+    IDXGIDevice* angle_dxgi_device) {
+  HRESULT result = ::DCompositionCreateDevice(
+      angle_dxgi_device, IID_PPV_ARGS(&composition_device_));
+  if (FAILED(result)) {
+    return Fail(result, "create DirectComposition device");
+  }
+  const HMODULE dcomp_module = ::GetModuleHandleW(L"dcomp.dll");
+  wait_for_compositor_clock_ =
+      dcomp_module
+          ? reinterpret_cast<WaitForCompositorClockProc>(::GetProcAddress(
+                dcomp_module, "DCompositionWaitForCompositorClock"))
+          : nullptr;
+  if (!wait_for_compositor_clock_) {
+    return Fail(HRESULT_FROM_WIN32(ERROR_PROC_NOT_FOUND),
+                "resolve DirectComposition compositor clock");
+  }
+
+  result = composition_device_->CreateTargetForHwnd(
+      reinterpret_cast<HWND>(config_.top_level_window), TRUE,
+      &composition_target_);
+  if (FAILED(result)) {
+    return Fail(result, "create topmost DirectComposition HWND target");
+  }
+  if (FAILED(result = composition_device_->CreateVisual(&root_visual_)) ||
+      FAILED(result = composition_device_->CreateVisual(&stage_visual_)) ||
+      FAILED(result = composition_device_->CreateVisual(&flutter_visual_))) {
+    return Fail(result, "create DirectComposition visuals");
+  }
+  if (FAILED(result = stage_visual_->SetContent(stage_swap_chain_.Get())) ||
+      FAILED(result = flutter_visual_->SetContent(flutter_swap_chain_.Get())) ||
+      FAILED(result = root_visual_->AddVisual(stage_visual_.Get(), FALSE,
+                                              nullptr)) ||
+      FAILED(result = root_visual_->AddVisual(flutter_visual_.Get(), TRUE,
+                                              stage_visual_.Get())) ||
+      FAILED(result = composition_target_->SetRoot(root_visual_.Get())) ||
+      FAILED(result = composition_device_->Commit())) {
+    return Fail(result, "commit DirectComposition visual tree");
+  }
+  state_->composition_tree_commit_count.fetch_add(1,
+                                                   std::memory_order_relaxed);
+  return true;
+}
+
+bool CompositionWindowSurface::CreateFlutterEglSurface(
+    ID3D11Device* angle_device) {
+  D3D11_TEXTURE2D_DESC texture_description{};
+  texture_description.Width = static_cast<UINT>(width_);
+  texture_description.Height = static_cast<UINT>(height_);
+  texture_description.MipLevels = 1;
+  texture_description.ArraySize = 1;
+  texture_description.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+  texture_description.SampleDesc.Count = 1;
+  texture_description.Usage = D3D11_USAGE_DEFAULT;
+  texture_description.BindFlags =
+      D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+
+  HRESULT result = angle_device->CreateTexture2D(&texture_description, nullptr,
+                                                 &flutter_buffer_.texture);
+  if (FAILED(result)) {
+    return Fail(result, "create Flutter intermediate render texture");
+  }
+  angle_device->GetImmediateContext(&flutter_context_);
+  if (!flutter_context_) {
+    return Fail(E_NOINTERFACE, "resolve Flutter D3D11 immediate context");
+  }
+
+  const EGLint attributes[] = {
+      EGL_WIDTH,
+      static_cast<EGLint>(width_),
+      EGL_HEIGHT,
+      static_cast<EGLint>(height_),
+      EGL_TEXTURE_INTERNAL_FORMAT_ANGLE,
+      GL_BGRA_EXT,
+      EGL_NONE,
+  };
+  flutter_buffer_.surface = manager_->CreateSurfaceFromHandle(
+      EGL_D3D_TEXTURE_ANGLE,
+      reinterpret_cast<EGLClientBuffer>(flutter_buffer_.texture.Get()),
+      attributes);
+  if (flutter_buffer_.surface == EGL_NO_SURFACE) {
+    return Fail(E_FAIL, "create Flutter EGL D3D texture surface");
+  }
+  return true;
+}
+
+void CompositionWindowSurface::StartStageProducer(
+    bool render_initial_frame) const {
+  stage_thread_ = std::thread(&CompositionWindowSurface::StageProducerMain,
+                              this, render_initial_frame);
+}
+
+void CompositionWindowSurface::StopStageProducer() {
+  if (stage_stop_event_) {
+    ::SetEvent(stage_stop_event_);
+  }
+  if (stage_thread_.joinable()) {
+    stage_thread_.join();
+  }
+}
+
+void CompositionWindowSurface::StageProducerMain(
+    bool render_initial_frame) const {
+  uint64_t frame_number =
+      state_->stage_present_count.load(std::memory_order_relaxed);
+  HRESULT result = render_initial_frame ? RenderSyntheticStage(frame_number++)
+                                        : S_OK;
+  while (SUCCEEDED(result)) {
+    const DWORD wait_result =
+        wait_for_compositor_clock_(1, &stage_stop_event_, INFINITE);
+    if (wait_result == WAIT_OBJECT_0) {
+      break;
+    }
+    if (wait_result != WAIT_OBJECT_0 + 1) {
+      FML_LOG(ERROR) << "Kirakara DirectComposition compositor clock wait "
+                        "failed (NTSTATUS 0x"
+                     << std::hex << wait_result << ")";
+      state_->last_stage_pacing_status.store(static_cast<int32_t>(wait_result),
+                                             std::memory_order_relaxed);
+      if (wait_result == kStatusGraphicsPresentOccluded) {
+        state_->stage_occluded_count.fetch_add(1, std::memory_order_relaxed);
+      }
+      break;
+    }
+    state_->last_stage_pacing_status.store(0, std::memory_order_relaxed);
+    state_->stage_wait_wake_count.fetch_add(1, std::memory_order_relaxed);
+    result = RenderSyntheticStage(frame_number++);
+  }
+}
+
+HRESULT CompositionWindowSurface::RenderSyntheticStage(
+    uint64_t frame_number) const {
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> texture;
+  HRESULT result = stage_swap_chain_->GetBuffer(
+      stage_swap_chain_->GetCurrentBackBufferIndex(), IID_PPV_ARGS(&texture));
+  if (FAILED(result)) {
+    state_->last_stage_present_hresult.store(result, std::memory_order_relaxed);
+    return result;
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11RenderTargetView> render_target;
+  result = stage_device_->CreateRenderTargetView(texture.Get(), nullptr,
+                                                 &render_target);
+  if (FAILED(result)) {
+    state_->last_stage_present_hresult.store(result, std::memory_order_relaxed);
+    return result;
+  }
+
+  const float phase = static_cast<float>(frame_number % 360) * 0.0174532925f;
+  const float color[] = {0.16f + 0.12f * (std::sin(phase) + 1.0f),
+                         0.08f + 0.10f * (std::sin(phase + 2.0943951f) + 1.0f),
+                         0.22f + 0.16f * (std::sin(phase + 4.1887902f) + 1.0f),
+                         1.0f};
+  stage_context_->OMSetRenderTargets(1, render_target.GetAddressOf(), nullptr);
+  stage_context_->ClearRenderTargetView(render_target.Get(), color);
+  stage_context_->OMSetRenderTargets(0, nullptr, nullptr);
+
+  // DCompositionWaitForCompositorClock is the synthetic source's sole pacing
+  // operation. Present only replaces the lower visual's latest content; it
+  // never waits for Flutter and needs no recurring timer or explicit Flush.
+  result = stage_swap_chain_->Present(0, 0);
+  state_->last_stage_present_hresult.store(result, std::memory_order_relaxed);
+  if (SUCCEEDED(result)) {
+    state_->stage_present_count.fetch_add(1, std::memory_order_relaxed);
+  } else if (result == DXGI_ERROR_DEVICE_REMOVED ||
+             result == DXGI_ERROR_DEVICE_RESET) {
+    state_->stage_device_removed_count.fetch_add(1, std::memory_order_relaxed);
+  }
+  return result;
+}
+
+bool CompositionWindowSurface::Fail(HRESULT result, const char* operation) {
+  valid_ = false;
+  if (state_) {
+    state_->active.store(false, std::memory_order_release);
+    if (resizing_) {
+      state_->last_resize_hresult.store(result, std::memory_order_release);
+    } else {
+      state_->initialization_hresult.store(result, std::memory_order_release);
+    }
+  }
+  FML_LOG(ERROR) << "Kirakara DirectComposition failed to " << operation
+                 << " (HRESULT 0x" << std::hex << static_cast<uint32_t>(result)
+                 << ")";
+  return false;
+}
+
+bool CompositionWindowSurface::Resize(size_t width, size_t height) {
+  if (!IsValid() || width == 0 || height == 0 ||
+      width > std::numeric_limits<UINT>::max() ||
+      height > std::numeric_limits<UINT>::max()) {
+    resizing_ = true;
+    return Fail(E_INVALIDARG, "validate composition surface resize");
+  }
+  if (width == width_ && height == height_) {
+    return true;
+  }
+
+  // Keep the HWND target and visual tree attached throughout the resize. The
+  // old implementation destroyed the whole surface here, committed a null
+  // root, and only then constructed a new tree. During interactive WM_SIZE
+  // traffic that deliberately exposed the uncomposited HWND as a white flash.
+  resizing_ = true;
+  StopStageProducer();
+  stage_restart_pending_ = false;
+
+  if (::eglGetCurrentContext() == context_ &&
+      ::eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       EGL_NO_CONTEXT) != EGL_TRUE) {
+    WINDOWS_LOG_EGL_ERROR;
+    return Fail(E_FAIL, "unbind Flutter EGL surface for resize");
+  }
+  if (flutter_buffer_.surface != EGL_NO_SURFACE) {
+    if (::eglDestroySurface(display_, flutter_buffer_.surface) != EGL_TRUE) {
+      WINDOWS_LOG_EGL_ERROR;
+      return Fail(E_FAIL, "destroy Flutter EGL surface for resize");
+    }
+    flutter_buffer_.surface = EGL_NO_SURFACE;
+  }
+  flutter_buffer_.texture.Reset();
+
+  // ResizeBuffers requires every direct and indirect reference to the old
+  // back buffers to be released. Flutter only accesses its current back buffer
+  // through a short-lived CopyResource destination, so no ANGLE state is
+  // disturbed here. The independent Stage context owns its pipeline state and
+  // can safely drop any remaining bindings without a per-frame Flush.
+  stage_context_->ClearState();
+
+  HRESULT result = flutter_swap_chain_->ResizeBuffers(
+      kSwapChainBufferCount, static_cast<UINT>(width),
+      static_cast<UINT>(height), DXGI_FORMAT_UNKNOWN, 0);
+  if (FAILED(result)) {
+    return Fail(result, "resize Flutter composition swapchain");
+  }
+  result = stage_swap_chain_->ResizeBuffers(
+      kSwapChainBufferCount, static_cast<UINT>(width),
+      static_cast<UINT>(height), DXGI_FORMAT_UNKNOWN, 0);
+  if (FAILED(result)) {
+    return Fail(result, "resize Stage composition swapchain");
+  }
+
+  width_ = width;
+  height_ = height;
+  Microsoft::WRL::ComPtr<ID3D11Device> angle_device;
+  flutter_context_->GetDevice(&angle_device);
+  if (!angle_device || !CreateFlutterEglSurface(angle_device.Get())) {
+    return false;
+  }
+
+  state_->width.store(static_cast<uint32_t>(width_),
+                      std::memory_order_relaxed);
+  state_->height.store(static_cast<uint32_t>(height_),
+                       std::memory_order_relaxed);
+  state_->last_resize_hresult.store(S_OK, std::memory_order_release);
+  state_->surface_resize_count.fetch_add(1, std::memory_order_relaxed);
+
+  // OnFrameGenerated immediately blits the already-produced Flutter frame and
+  // calls SwapBuffers. Deferring Stage restart until that Present keeps DWM
+  // from composing a resized lower visual with an undefined upper buffer.
+  if (!::ResetEvent(stage_stop_event_)) {
+    return Fail(HRESULT_FROM_WIN32(::GetLastError()),
+                "reset Stage stop event after resize");
+  }
+  stage_restart_pending_ = true;
+  resizing_ = false;
+  return true;
+}
+
+bool CompositionWindowSurface::Destroy() {
+  if (destroyed_) {
+    return true;
+  }
+  destroyed_ = true;
+  valid_ = false;
+  if (state_) {
+    state_->active.store(false, std::memory_order_release);
+  }
+
+  StopStageProducer();
+
+  if (::eglGetCurrentContext() == context_) {
+    ::eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+  }
+  if (flutter_buffer_.surface != EGL_NO_SURFACE) {
+    ::eglDestroySurface(display_, flutter_buffer_.surface);
+    flutter_buffer_.surface = EGL_NO_SURFACE;
+  }
+  flutter_buffer_.texture.Reset();
+
+  if (flutter_visual_) {
+    flutter_visual_->SetContent(nullptr);
+  }
+  if (stage_visual_) {
+    stage_visual_->SetContent(nullptr);
+  }
+  if (root_visual_) {
+    root_visual_->RemoveAllVisuals();
+  }
+  if (composition_target_) {
+    composition_target_->SetRoot(nullptr);
+  }
+  if (composition_device_) {
+    composition_device_->Commit();
+  }
+
+  flutter_visual_.Reset();
+  stage_visual_.Reset();
+  root_visual_.Reset();
+  composition_target_.Reset();
+  composition_device_.Reset();
+  wait_for_compositor_clock_ = nullptr;
+  flutter_swap_chain_.Reset();
+  flutter_context_.Reset();
+
+  stage_swap_chain_.Reset();
+  stage_context_.Reset();
+  stage_device_.Reset();
+  if (stage_stop_event_) {
+    ::CloseHandle(stage_stop_event_);
+    stage_stop_event_ = nullptr;
+  }
+
+  is_valid_ = false;
+  surface_ = EGL_NO_SURFACE;
+  return true;
+}
+
+bool CompositionWindowSurface::IsValid() const {
+  return valid_ && !destroyed_ && flutter_buffer_.texture &&
+         flutter_buffer_.surface != EGL_NO_SURFACE && flutter_context_;
+}
+
+bool CompositionWindowSurface::IsCurrent() const {
+  if (!IsValid()) {
+    return false;
+  }
+  const EGLSurface surface = flutter_buffer_.surface;
+  return display_ == ::eglGetCurrentDisplay() &&
+         surface == ::eglGetCurrentSurface(EGL_DRAW) &&
+         surface == ::eglGetCurrentSurface(EGL_READ) &&
+         context_ == ::eglGetCurrentContext();
+}
+
+bool CompositionWindowSurface::MakeCurrent() const {
+  if (!IsValid()) {
+    return false;
+  }
+  const EGLSurface surface = flutter_buffer_.surface;
+  if (::eglMakeCurrent(display_, surface, surface, context_) != EGL_TRUE) {
+    WINDOWS_LOG_EGL_ERROR;
+    return false;
+  }
+  return true;
+}
+
+bool CompositionWindowSurface::SwapBuffers() const {
+  if (!IsValid()) {
+    return false;
+  }
+  const EGLSurface surface = flutter_buffer_.surface;
+  if (::eglSwapBuffers(display_, surface) != EGL_TRUE) {
+    WINDOWS_LOG_EGL_ERROR;
+    return false;
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> swap_chain_buffer;
+  HRESULT result = flutter_swap_chain_->GetBuffer(
+      flutter_swap_chain_->GetCurrentBackBufferIndex(),
+      IID_PPV_ARGS(&swap_chain_buffer));
+  if (FAILED(result)) {
+    FML_LOG(ERROR)
+        << "Kirakara Flutter composition GetBuffer failed (HRESULT 0x"
+        << std::hex << static_cast<uint32_t>(result) << ")";
+    return false;
+  }
+  flutter_context_->CopyResource(swap_chain_buffer.Get(),
+                                 flutter_buffer_.texture.Get());
+
+  result = flutter_swap_chain_->Present(vsync_enabled_ ? 1 : 0, 0);
+  if (FAILED(result)) {
+    FML_LOG(ERROR) << "Kirakara Flutter composition Present failed (HRESULT 0x"
+                   << std::hex << static_cast<uint32_t>(result) << ")";
+    return false;
+  }
+  state_->flutter_present_count.fetch_add(1, std::memory_order_relaxed);
+
+  if (stage_restart_pending_) {
+    const uint64_t frame_number =
+        state_->stage_present_count.load(std::memory_order_relaxed);
+    const HRESULT stage_result = RenderSyntheticStage(frame_number);
+    if (FAILED(stage_result)) {
+      return false;
+    }
+    stage_restart_pending_ = false;
+    StartStageProducer(false);
+  }
+  return true;
+}
+
+const EGLSurface& CompositionWindowSurface::GetHandle() const {
+  if (!IsValid()) {
+    return surface_;
+  }
+  return flutter_buffer_.surface;
+}
+
+bool CompositionWindowSurface::SetVSyncEnabled(bool enabled) {
+  vsync_enabled_ = enabled;
+  return true;
+}
+
+size_t CompositionWindowSurface::width() const {
+  return width_;
+}
+
+size_t CompositionWindowSurface::height() const {
+  return height_;
+}
+
+bool CompositionWindowSurface::vsync_enabled() const {
+  return vsync_enabled_;
+}
+
+}  // namespace egl
+}  // namespace flutter
